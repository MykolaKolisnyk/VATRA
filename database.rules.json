{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'handle'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "handle": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "bio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 160)"
        },
        "avatarUrl": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2048)"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && (!newData.exists() || newData.child('authorUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['authorUid', 'authorName', 'authorHandle', 'text', 'createdAt'])",
        "authorUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "authorHandle": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "imageUrl": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 3000)"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "postLikes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('posts').child($postId).child('authorUid').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "comments": {
      ".read": "auth != null",
      "$postId": {
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || root.child('posts').child($postId).child('authorUid').val() === auth.uid)))",
          ".validate": "!newData.exists() || newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "saved": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$postId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "following": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$targetUid": {
          ".write": "auth != null && auth.uid === $uid && $targetUid !== auth.uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "videos": {
      ".read": "auth != null",
      "$videoId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && (!newData.exists() || newData.child('authorUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['authorUid', 'videoUrl', 'createdAt'])",
        "authorUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "videoUrl": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "text": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'ownerUid', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "description": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 240)"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "groupMembers": {
      ".read": "auth != null",
      "$groupId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('groups').child($groupId).exists()",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "groupPosts": {
      ".read": "auth != null",
      "$groupId": {
        "$postId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).val() === true && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid && (!newData.exists() || newData.child('authorUid').val() === auth.uid)))",
          ".validate": "!newData.exists() || newData.hasChildren(['authorUid', 'authorName', 'text', 'createdAt'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1200"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && !data.exists() && newData.child('members').child(auth.uid).val() === true && newData.child('members').hasChildren()",
        "messages": {
          "$messageId": {
            ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && ((!data.exists() && newData.child('senderUid').val() === auth.uid) || (data.exists() && data.child('senderUid').val() === auth.uid && !newData.exists()))",
            ".validate": "!newData.exists() || newData.hasChildren(['senderUid', 'text', 'createdAt'])",
            "senderUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || (root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && root.child('chats').child($chatId).child('members').child($uid).val() === true))",
          ".validate": "!newData.exists() || newData.hasChildren(['otherUid', 'updatedAt'])"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)",
          ".validate": "!newData.exists() || newData.hasChildren(['from','to','status'])"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    }
  }
}