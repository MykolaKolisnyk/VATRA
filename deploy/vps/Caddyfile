# VATRA on a self-managed VPS.
# Set VATRA_DOMAIN in Caddy's systemd environment before starting.
# Published files: /srv/vatra/www/VATRA/*.html and /srv/vatra/www/VATRA/assets/...
#
# Unlike GitHub Pages, Caddy internally rewrites clean routes with real HTTP 200.
# The browser sees /VATRA/id123 (or /id123), not profile.html or 404.html.

{$VATRA_DOMAIN} {
    root * /srv/vatra/www
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }

    @member path_regexp member ^/(?:VATRA/)?id[1-9][0-9]{0,18}$
    @community path_regexp community ^/(?:VATRA/)?club[1-9][0-9]{0,18}$
    @homepage path / /VATRA /VATRA/
    @htmlpage path_regexp htmlpage ^/(?:VATRA/)?(feed|profile|club|communities|notifications|create-account|forgot|reset|verify|terms|privacy|cookies|offline)$

    route {
        handle @member {
            rewrite * /VATRA/profile.html
            file_server
        }
        handle @community {
            rewrite * /VATRA/club.html
            file_server
        }
        handle @homepage {
            rewrite * /VATRA/index.html
            file_server
        }
        handle @htmlpage {
            rewrite * /VATRA/{re.htmlpage.1}.html
            file_server
        }
        handle {
            file_server
        }
    }

    # Actual missing assets and unknown paths must stay HTTP 404.
    handle_errors 404 {
        rewrite * /VATRA/404.html
        file_server
    }
}
