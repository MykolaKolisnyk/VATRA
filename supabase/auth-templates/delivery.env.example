# Copy to a private local .env file or set these environment variables in your deployment environment.
# Never commit credentials; do not paste them into a public issue/PR or chat.
VATRA_SUPABASE_ACCESS_TOKEN=
VATRA_EMAIL_FROM=no-reply@your-verified-domain.example
VATRA_SMTP_HOST=
VATRA_SMTP_PORT=587
VATRA_SMTP_USER=
VATRA_SMTP_PASSWORD=
# SMS provider: twilio, vonage or messagebird.
VATRA_SMS_PROVIDER=twilio
VATRA_SMS_TWILIO_ACCOUNT_SID=
VATRA_SMS_TWILIO_AUTH_TOKEN=
VATRA_SMS_TWILIO_MESSAGE_SERVICE_SID=
# Only when choosing vonage:
VATRA_SMS_VONAGE_API_KEY=
VATRA_SMS_VONAGE_API_SECRET=
VATRA_SMS_VONAGE_FROM=VATRA
# Only when choosing messagebird:
VATRA_SMS_MESSAGEBIRD_ACCESS_KEY=
VATRA_SMS_MESSAGEBIRD_ORIGINATOR=VATRA
