# ВАТРА: ГОЛОВНИЙ САЙТ залишається на GitHub Pages.
# Тільки зразок: НІКОЛИ не комітьте секрети й не надсилайте їх у чат.
# Виберіть email, sms або both. Почніть з email без SMS акаунта.
VATRA_AUTH_CHANNEL=email
VATRA_SUPABASE_ACCESS_TOKEN=

# Пілот БЕЗ власного домену: окрема скринька Gmail з увімкненою 2FA.
# Для Gmail VATRA_EMAIL_FROM і VATRA_SMTP_USER мають збігатися.
# Використовуйте Google App Password (не пароль від облікового запису).
# Gmail не є рекомендованим SMTP для публічної соціальної мережі.
VATRA_EMAIL_FROM=your-vatra-mailbox@gmail.com
VATRA_SMTP_HOST=smtp.gmail.com
VATRA_SMTP_PORT=587
VATRA_SMTP_USER=your-vatra-mailbox@gmail.com
VATRA_SMTP_PASSWORD=

# Для масштабування пізніше можна змінити адресу на
# noreply@your-verified-domain.example і SMTP-провайдера без зміни сайту.
# Для SMS увімкніть VATRA_AUTH_CHANNEL=sms або both.
VATRA_SMS_PROVIDER=twilio
VATRA_SMS_TWILIO_ACCOUNT_SID=
VATRA_SMS_TWILIO_AUTH_TOKEN=
VATRA_SMS_TWILIO_MESSAGE_SERVICE_SID=
# Альтернатива Twilio: Vonage
VATRA_SMS_VONAGE_API_KEY=
VATRA_SMS_VONAGE_API_SECRET=
VATRA_SMS_VONAGE_FROM=VATRA
# Альтернатива Twilio: MessageBird
VATRA_SMS_MESSAGEBIRD_ACCESS_KEY=
VATRA_SMS_MESSAGEBIRD_ORIGINATOR=VATRA
